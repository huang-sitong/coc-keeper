{
  "id": "the-haunting-7e",
  "title": "《鬼屋》（七版）",
  "description": "根据《鬼屋》七版模组整理的故事流程图：调查员在波士顿调查科比特老房子，最终面对沃尔特·科比特。",
  "startNodeId": "start",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "title": "场景1：介绍与委托",
      "text": "1920年代波士顿。房东诺特先生委托调查员调查科比特老房子，交给钥匙、地址和25美元。调查员可以先在城里调查，也可以直接前往老房子。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "job_accepted",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "hub",
      "type": "scene",
      "title": "调查阶段",
      "text": "调查员可以自由选择下一处调查地点：报社、图书馆、档案馆、法院/警察局、街区、疗养院、礼拜堂，或直接前往科比特老房子。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "newspaper_attempt",
      "type": "scene",
      "title": "场景2：波士顿环球报社",
      "text": "调查员尝试查阅剪报文件。需要说服/魅惑/恐吓/话术等社交检定来获得阿蒂·威尔莫特的许可。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "newspaper_success",
      "type": "scene",
      "title": "报社：获得剪报",
      "text": "阿蒂让调查员查阅资料。罗斯·布莱克带他们进入地下室资料室，获得文字材料2：科比特老房子过去多次发生悲剧。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "newspaper_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "newspaper_failure",
      "type": "scene",
      "title": "报社：被拒绝",
      "text": "阿蒂拒绝提供帮助。调查员可以选择孤注一骰再次尝试，或先离开。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "library_attempt",
      "type": "scene",
      "title": "场景3：中央图书馆",
      "text": "调查员花半天在图书馆检索。每次成功获得一条关于房子历史的线索（文字材料3-6）。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "library_success",
      "type": "scene",
      "title": "图书馆：查到历史",
      "text": "调查员找到科比特老房子的历史记录：1835年建屋、科比特购买、诉讼、1866年讣告与遗嘱纠纷等。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "library_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "library_failure",
      "type": "scene",
      "title": "图书馆：一无所获",
      "text": "这次检索没有找到关键信息。可以再花半天继续尝试，或离开。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "archives_attempt",
      "type": "scene",
      "title": "场景4：档案馆",
      "text": "调查员查阅公民/刑事法院记录，需要图书馆使用检定。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "archives_success",
      "type": "scene",
      "title": "档案馆：找到遗嘱执行人",
      "text": "记录显示科比特遗嘱执行人是沉思礼拜堂的麦可尔·托马斯牧师；教堂于1912年关闭。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "archives_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "archives_failure",
      "type": "scene",
      "title": "档案馆：没有收获",
      "text": "调查员没有找到关键记录，可以再试或离开。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "court_attempt",
      "type": "scene",
      "title": "场景5：高等法院/中央警察局",
      "text": "查阅警方突袭沉思礼拜堂的记录非常困难，需要法律、信用评级、说服、魅惑或话术检定。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "court_success",
      "type": "scene",
      "title": "法院/警察局：突袭记录",
      "text": "调查员获得文字材料8：1912年警方突袭沉思礼拜堂，多人死亡，牧师托马斯被捕后越狱。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "court_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "court_failure",
      "type": "scene",
      "title": "法院/警察局：被拒绝",
      "text": "调查员未能获得许可。可以孤注一骰冒险再试，或离开。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "neighborhood",
      "type": "scene",
      "title": "场景6：街区",
      "text": "调查员遇到报摊小贩佐利先生。他认识科比特老房子和马卡里奥一家，能提供不少邻里传闻。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "neighborhood_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "sanitarium",
      "type": "scene",
      "title": "场景7：罗克斯伯里疗养院",
      "text": "维托里奥·马卡里奥疯癫地抱着圣经，说出“恶魔终将被他自己的武器所击败”。加布里埃尔描述房子里有邪恶存在。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "sanitarium_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "chapel",
      "type": "scene",
      "title": "场景8：沉思礼拜堂",
      "text": "废墟中有三Y一眼的标记。搜索可发现地下室、两具骷髅、腐坏的礼拜堂记录、日记和《伊波恩之书》手抄本。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "chapel_clue",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "house",
      "type": "scene",
      "title": "场景9：科比特老房子",
      "text": "老房子外观破败，门窗被封死。调查员可以从一楼、二楼或地下室开始探索。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "house_entered",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "house_first_floor",
      "type": "scene",
      "title": "老房子：一楼",
      "text": "储藏室、门厅、客厅、餐厅、厨房。储藏室柜子里有科比特的三本日记，记录隐秘实验和法术。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "first_floor_searched",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "house_second_floor",
      "type": "scene",
      "title": "老房子：二楼",
      "text": "主卧室、儿童房、空卧室、浴室。空卧室是科比特的精神残留地，可能发生灵异现象。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "second_floor_searched",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "bed_attack",
      "type": "scene",
      "title": "老房子：床架攻击",
      "text": "科比特用窗户响声吸引调查员，再猛推床架撞击。被砸中会受到1D6+2伤害，目击者需进行理智检定。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "bed_attack_happened",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "house_basement",
      "type": "scene",
      "title": "老房子：地下室",
      "text": "楼梯危险，需要敏捷/攀爬检定。地下室里可搜索到科比特的浮空匕首，墙后可能藏着鼠群和科比特的藏身处。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "basement_dagger",
      "type": "scene",
      "title": "地下室：发现浮空匕首",
      "text": "调查员在杂物堆中找到科比特的魔法匕首。匕首会浮空攻击，目击者需理智检定；也可尝试用战技抓住它。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "dagger_found",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "basement_rats",
      "type": "scene",
      "title": "地下室：鼠群",
      "text": "墙壁夹层里有一群老鼠。鼠群会蜂拥攻击，但杀死一两只后就会溃逃。墙内刻着“沉思礼拜堂”。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "rats_encountered",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "corbitt_lair",
      "type": "scene",
      "title": "科比特的藏身处",
      "text": "打破墙壁后进入密室。平台上躺着科比特干尸般的躯体。战斗随时开始；若用夺来的匕首攻击，可将其彻底消灭。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "corbitt_victory",
      "type": "scene",
      "title": "击败科比特",
      "text": "科比特的躯体化为尘埃。调查员解决了鬼屋事件。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "corbitt_defeated",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "corbitt_defeat",
      "type": "scene",
      "title": "调查员倒下或疯狂",
      "text": "科比特取得了胜利，调查员死亡或陷入疯狂。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "party_defeated",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "corbitt_flee",
      "type": "scene",
      "title": "未能解决事件",
      "text": "调查员逃离老房子，没有解决科比特。诺特先生之后会在房子里被杀死，调查员被警方怀疑。",
      "enterActions": [
        {
          "kind": "setFlag",
          "flag": "fled_without_resolution",
          "value": true
        }
      ],
      "exitActions": []
    },
    {
      "id": "ending_success",
      "type": "end",
      "title": "结局：成功",
      "text": "房东诺特先生非常高兴，支付报酬；调查员恢复1D6 SAN，并可保留礼拜堂找到的书籍。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "ending_failure",
      "type": "end",
      "title": "结局：失败",
      "text": "调查员未能解决事件。诺特先生在地下室被科比特杀死，调查员被警方带走。",
      "enterActions": [],
      "exitActions": []
    },
    {
      "id": "ending_death_madness",
      "type": "end",
      "title": "结局：死亡或疯狂",
      "text": "调查员或死或疯，被科比特的魔法吞噬。",
      "enterActions": [],
      "exitActions": []
    }
  ],
